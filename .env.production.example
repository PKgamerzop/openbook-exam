# Copy to .env.staging or .env.production. Supply a random 32+ character password.
OPENBOOK_ENV=staging
OPENBOOK_ORIGIN=https://localhost:8443
OPENBOOK_BIND=127.0.0.1
OPENBOOK_HTTPS_PORT=8443
OPENBOOK_TLS_DIRECTIVE=tls internal
POSTGRES_DB=openbook
POSTGRES_USER=openbook
POSTGRES_PASSWORD=replace-with-generated-password
