POSTGRES_DB=openbook
POSTGRES_USER=openbook
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Loopback HTTP development only. Unset for HTTPS deployments.
OPENBOOK_LOCAL_HTTP=1
# Optional absolute directory outside the frontend, shared by API and worker.
# OPENBOOK_PDF_DIR=D:/OpenBook/private-pdfs
OPENBOOK_PDF_MAX_BYTES=20971520
OPENBOOK_PDF_MAX_PAGES=200
